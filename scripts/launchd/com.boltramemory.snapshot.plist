<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly `aim snapshot` at 04:00. Same placeholders as com.boltramemory.server.plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.boltramemory.snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string><PYTHON></string>
    <string><ROOT>/bin/aim</string>
    <string>snapshot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string><HOME>/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string><HOME></string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string><HOME>/Library/Logs/boltramemory/snapshot.log</string>
  <key>StandardErrorPath</key><string><HOME>/Library/Logs/boltramemory/snapshot.log</string>
</dict>
</plist>
